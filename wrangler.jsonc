{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ingredient-scanner-mvp",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
