{
  "name": "ingredient-scanner-mvp",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  "build": {
    "command": "node scripts/vendor-ocr.mjs"
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ingredient-scanner-db",
      "database_id": "2b7dc2fb-e684-4d9b-999b-3cb4d7282078"
    }
  ]
}
